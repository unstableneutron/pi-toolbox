{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "ignoreBinaries": ["aubr"],
  "ignoreDependencies": [
    "@earendil-works/pi-agent-core",
    "@aws-sdk/client-bedrock-runtime",
    "fff-router",
    "partial-json",
    "picomatch",
    "shell-quote",
    "tsx",
    "ws"
  ],
  "ignoreFiles": ["extensions/pi-fff-search/fff-router.d.ts"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "workspaces": {
    ".": {
      "entry": ["bin/*.js", "extensions/**/index.ts", "scripts/*.js", "scripts/*.ts"],
      "project": [
        "bin/*.js",
        "extensions/**/*.ts",
        "packages/**/*.js",
        "scripts/**/*.js",
        "scripts/**/*.ts",
        "tests/**/*.ts"
      ]
    },
    "extensions/*": {
      "entry": ["index.ts"],
      "project": ["**/*.ts"]
    },
    "extensions/openai-websocket-responses": {
      "entry": ["index.ts", "omp.ts"],
      "project": ["**/*.ts"]
    },
    "extensions/pi-retry": {
      "entry": ["index.ts", "omp.ts"],
      "project": ["**/*.ts"]
    },
    "extensions/pi-codex-app-server-use": {
      "entry": ["index.ts", "src/extension.ts"],
      "project": ["**/*.ts"]
    },
    "extensions/pi-fff-search": {
      "entry": ["index.ts"],
      "project": ["**/*.ts"]
    },
    "extensions/pi-codex-browser": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/*.mjs", "scripts/*.ts"]
    },
    "extensions/bash-rewrite": {
      "entry": ["scripts/*.ts"],
      "project": ["**/*.ts"]
    },
    "packages/roundtable-review": {
      "entry": ["bin/*.js"],
      "project": ["**/*.js"]
    }
  }
}
