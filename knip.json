{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "ignoreDependencies": ["@earendil-works/pi-agent-core", "@aws-sdk/client-bedrock-runtime", "tsx"],
  "workspaces": {
    ".": {
      "entry": ["extensions/**/index.ts", "scripts/*.ts"],
      "project": ["extensions/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
    },
    "extensions/*": {
      "entry": ["index.ts"],
      "project": ["**/*.ts"]
    },
    "extensions/pi-fff-search": {
      "entry": ["index.ts", "scripts/*.ts"],
      "project": ["**/*.ts"]
    }
  }
}
