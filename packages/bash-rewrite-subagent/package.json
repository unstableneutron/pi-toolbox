{
  "name": "pi-bash-rewrite-subagent",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only pi-subagents bundle for bash rewrites, FFF, and multi-edit",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "npm run check:lint && npm run check:format",
    "check:lint": "oxlint -c .oxlintrc.json --type-aware --type-check --deny-warnings .",
    "check:format": "oxfmt -c .oxfmtrc.json --check .",
    "fix": "npm run fix:lint && npm run fix:format",
    "fix:lint": "oxlint -c .oxlintrc.json --type-aware --type-check --fix --fix-suggestions --fix-dangerously .",
    "fix:format": "oxfmt -c .oxfmtrc.json .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@types/node": "^24.3.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.1"
  }
}
