{
  "name": "pi-retry",
  "version": "0.2.6",
  "description": "Pi package for retryable terminal-leaf recovery, including refusals, empty stops, stranded tool results, retryable errors, and manual /retry",
  "keywords": [
    "aborted",
    "pi-extension",
    "pi-package",
    "recovery",
    "refusal",
    "retry",
    "session-resume"
  ],
  "type": "module",
  "scripts": {
    "check": "pnpm run check:lint && pnpm run check:format",
    "check:lint": "pnpm exec oxlint -c .oxlintrc.json --type-aware --type-check --deny-warnings .",
    "check:format": "pnpm exec oxfmt -c .oxfmtrc.json --check .",
    "fix": "pnpm run fix:lint && pnpm run fix:format",
    "fix:lint": "pnpm exec oxlint -c .oxlintrc.json --type-aware --type-check --fix --fix-suggestions --fix-dangerously .",
    "fix:format": "pnpm exec oxfmt -c .oxfmtrc.json .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.79.0",
    "@earendil-works/pi-coding-agent": "^0.79.0",
    "@types/node": "^24.3.0",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "oxlint-tsgolint": "^0.20.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "prettier": {
    "singleQuote": true
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "omp": {
    "extensions": [
      "./omp.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
