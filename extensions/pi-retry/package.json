{
  "name": "pi-retry",
  "version": "0.1.1",
  "description": "Pi package for retryable terminal-leaf recovery, including refusals, empty stops, empty aborted turns, retryable errors, and manual /retry",
  "keywords": [
    "aborted",
    "pi-extension",
    "pi-package",
    "recovery",
    "refusal",
    "retry",
    "session-resume"
  ],
  "type": "module",
  "scripts": {
    "check": "pnpm run check:lint && pnpm run check:format",
    "check:lint": "pnpm exec oxlint -c .oxlintrc.json --type-aware --type-check --deny-warnings .",
    "check:format": "pnpm exec oxfmt -c .oxfmtrc.json --check .",
    "fix": "pnpm run fix:lint && pnpm run fix:format",
    "fix:lint": "pnpm exec oxlint -c .oxlintrc.json --type-aware --type-check --fix --fix-suggestions --fix-dangerously .",
    "fix:format": "pnpm exec oxfmt -c .oxfmtrc.json .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "^0.65.0",
    "@mariozechner/pi-coding-agent": "^0.65.0",
    "@types/node": "^24.3.0",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "oxlint-tsgolint": "^0.20.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*"
  },
  "prettier": {
    "singleQuote": true
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
