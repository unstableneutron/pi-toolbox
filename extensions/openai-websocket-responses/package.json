{
  "name": "openai-websocket-responses",
  "version": "0.5.2",
  "description": "Pi package providing shared SSE and WebSocket transports for OpenAI Responses APIs",
  "keywords": [
    "azure-openai",
    "pi-extension",
    "pi-package",
    "responses-api",
    "websocket"
  ],
  "type": "module",
  "scripts": {
    "check": "pnpm run check:lint && pnpm run check:format",
    "check:lint": "pnpm exec oxlint -c .oxlintrc.json --type-aware --type-check --deny-warnings .",
    "check:format": "pnpm exec oxfmt -c .oxfmtrc.json --check .",
    "fix": "pnpm run fix:lint && pnpm run fix:format",
    "fix:lint": "pnpm exec oxlint -c .oxlintrc.json --type-aware --type-check --fix --fix-suggestions --fix-dangerously .",
    "fix:format": "pnpm exec oxfmt -c .oxfmtrc.json .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.83.0",
    "@earendil-works/pi-coding-agent": ">=0.83.0"
  },
  "prettier": {
    "singleQuote": true
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "omp": {
    "extensions": [
      "./omp.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
