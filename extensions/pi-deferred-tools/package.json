{
  "name": "pi-deferred-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Additive deferred tool discovery and activation for Pi",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "aubr check:lint && aubr check:format",
    "check:lint": "oxlint -c ../../.oxlintrc.json --type-aware --type-check --deny-warnings .",
    "check:format": "oxfmt -c ../../.oxfmtrc.json --check .",
    "fix": "aubr fix:lint && aubr fix:format",
    "fix:lint": "oxlint -c ../../.oxlintrc.json --type-aware --type-check --fix --fix-suggestions --fix-dangerously .",
    "fix:format": "oxfmt -c ../../.oxfmtrc.json .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@types/node": "^24.3.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typebox": "^1.1.24",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.1",
    "@earendil-works/pi-coding-agent": ">=0.84.1",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
