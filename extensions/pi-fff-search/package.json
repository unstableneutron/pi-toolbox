{
  "name": "pi-fff-search",
  "version": "0.10.0",
  "description": "Pi extension for FFF-backed search and robust format-aware reading",
  "keywords": [
    "pi-extension",
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "check": "aube run check:lint && aube run check:format",
    "check:lint": "oxlint -c .oxlintrc.json --type-aware --type-check --deny-warnings .",
    "check:format": "oxfmt -c .oxfmtrc.json --check .",
    "fix": "aube run fix:lint && aube run fix:format",
    "fix:lint": "oxlint -c .oxlintrc.json --type-aware --type-check --fix --fix-suggestions --fix-dangerously .",
    "fix:format": "oxfmt -c .oxfmtrc.json .",
    "test": "vitest run"
  },
  "dependencies": {
    "fff-router": "github:unstableneutron/fff-router#semver:>=0.8.0",
    "picomatch": "^4.0.3"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/node": "^24.3.0",
    "@types/picomatch": "^4.0.3",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typebox": "^1.1.24",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.84.1",
    "@earendil-works/pi-ai": ">=0.84.1",
    "@earendil-works/pi-coding-agent": ">=0.84.1",
    "@earendil-works/pi-tui": ">=0.84.1",
    "typebox": "*"
  },
  "optionalDependencies": {
    "@firecrawl/anydoc": "0.1.7",
    "@firecrawl/pdf-inspector": "1.12.0"
  },
  "prettier": {
    "singleQuote": true
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
