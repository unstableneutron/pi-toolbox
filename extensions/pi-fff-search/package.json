{
  "name": "pi-fff-search",
  "version": "0.7.0",
  "description": "Pi extension for FFF-backed repository search with local fallbacks",
  "keywords": [
    "pi-extension",
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "check": "pnpm run check:lint && pnpm run check:format",
    "check:lint": "oxlint -c .oxlintrc.json --type-aware --type-check --deny-warnings .",
    "check:format": "oxfmt -c .oxfmtrc.json --check .",
    "fix": "pnpm run fix:lint && pnpm run fix:format",
    "fix:lint": "oxlint -c .oxlintrc.json --type-aware --type-check --fix --fix-suggestions --fix-dangerously .",
    "fix:format": "oxfmt -c .oxfmtrc.json .",
    "test": "vitest run"
  },
  "dependencies": {
    "fff-router": "github:unstableneutron/fff-router#semver:>=0.6.1",
    "picomatch": "^4.0.3",
    "shell-quote": "^1.8.3"
  },
  "devDependencies": {
    "@mariozechner/pi-agent-core": "^0.65.0",
    "@mariozechner/pi-coding-agent": "^0.65.0",
    "@mariozechner/pi-tui": "^0.65.0",
    "@types/node": "^24.3.0",
    "@types/picomatch": "^4.0.3",
    "@types/shell-quote": "^1.7.5",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "oxlint-tsgolint": "^0.20.0",
    "typebox": "^1.1.24",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@mariozechner/pi-agent-core": "*",
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "typebox": "*"
  },
  "prettier": {
    "singleQuote": true
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "pi": {
    "extension": "./index.ts"
  }
}
