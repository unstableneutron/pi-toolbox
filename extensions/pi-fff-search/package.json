{
  "name": "pi-fff-search",
  "version": "0.8.2",
  "description": "Pi extension for FFF-backed repository search with local fallbacks",
  "keywords": [
    "pi-extension",
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "check": "pnpm run check:lint && pnpm run check:format",
    "check:lint": "oxlint -c .oxlintrc.json --type-aware --type-check --deny-warnings .",
    "check:format": "oxfmt -c .oxfmtrc.json --check .",
    "fix": "pnpm run fix:lint && pnpm run fix:format",
    "fix:lint": "oxlint -c .oxlintrc.json --type-aware --type-check --fix --fix-suggestions --fix-dangerously .",
    "fix:format": "oxfmt -c .oxfmtrc.json .",
    "test": "vitest run"
  },
  "dependencies": {
    "fff-router": "github:unstableneutron/fff-router#semver:>=0.8.0",
    "picomatch": "^4.0.3"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "@types/node": "^24.3.0",
    "@types/picomatch": "^4.0.3",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typebox": "^1.1.24",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "prettier": {
    "singleQuote": true
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
