{
  "name": "pi-bash-rewrite",
  "version": "0.1.4",
  "description": "Optional Pi bash tool rewrite orchestrator with provider hooks",
  "keywords": [
    "bash",
    "pi",
    "pi-package",
    "shared-helper",
    "tool-rewrite"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./apply-patch": "./apply-patch.ts"
  },
  "scripts": {
    "check": "pnpm run check:lint && pnpm run check:format",
    "check:lint": "oxlint -c .oxlintrc.json --type-aware --type-check --deny-warnings .",
    "check:format": "oxfmt -c .oxfmtrc.json --check .",
    "fix": "pnpm run fix:lint && pnpm run fix:format",
    "fix:lint": "oxlint -c .oxlintrc.json --type-aware --type-check --fix --fix-suggestions --fix-dangerously .",
    "fix:format": "oxfmt -c .oxfmtrc.json .",
    "test": "vitest run"
  },
  "dependencies": {
    "shell-quote": "^1.8.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "@earendil-works/pi-tui": "^0.82.0",
    "@types/node": "^24.3.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "prettier": {
    "singleQuote": true
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
